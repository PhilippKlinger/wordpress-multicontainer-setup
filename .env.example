# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

# Non-sensitive values match the defaults declared in docker-compose.yaml.
WORDPRESS_VERSION=7.0.2-php8.3-apache
MARIADB_VERSION=11.4.12
HOST_PORT=8080
WORDPRESS_DB_NAME=wordpress

# Required credentials intentionally have no default.
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
